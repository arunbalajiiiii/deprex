{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/user/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/journal/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/assessment/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/relief-events(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/chat-events(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/ai/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/health",
      "dest": "app/main.py"
    },
    {
      "src": "/docs",
      "dest": "app/main.py"
    },
    {
      "src": "/openapi.json",
      "dest": "app/main.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
