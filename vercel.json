{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/user/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/journal/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/assessment/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/relief-events:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat-events:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/ai/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
